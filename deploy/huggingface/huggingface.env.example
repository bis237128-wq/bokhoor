DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=replace-with-supabase-postgres-host
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=replace-with-database-name
DB_POSTGRESDB_USER=replace-with-database-user
DB_POSTGRESDB_PASSWORD=replace-with-database-password
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
N8N_HOST=replace-with-space-hostname-without-https
N8N_PORT=7860
N8N_PROTOCOL=https
WEBHOOK_URL=https://replace-with-space-hostname/
N8N_ENCRYPTION_KEY=replace-with-a-unique-random-32-character-key
