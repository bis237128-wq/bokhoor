          "name": "Bakhoor Edge Function Authorization"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json;\nconst data = input.body ?? input;\nif (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('Order body must be an object');\nconst orderNumber = String(data.order_number ?? '').trim();\nif (!/^BKH-\\d{10,}-[A-Z0-9]{5}$/.test(orderNumber)) throw new Error('Invalid order reference');\nconst createdAt = Date.parse(data.created_at);\nif (!Number.isFinite(createdAt) || Date.now() - createdAt > 15 * 60 * 1000 || createdAt > Date.now() + 60_000) throw new Error('Order is outside the notification window');\nconst name = String(data.customer_name ?? '').trim();\nif (!name || name.length > 100) throw new Error('Customer name is required and must be at most 100 characters');\nconst digits = String(data.customer_phone ?? '').replace(/\\D/g, '');\nlet phone = digits;\nif (phone.startsWith('0020')) phone = phone.slice(2);\nif (phone.startsWith('0')) phone = '20' + phone.slice(1);\nif (phone.length === 10 && phone.startsWith('1')) phone = '20' + phone;\nif (!/^201[0125]\\d{8}$/.test(phone)) throw new Error('Customer phone must be a valid Egyptian mobile number');\nif (!Array.isArray(data.items) || data.items.length === 0 || data.items.length > 50) throw new Error('Order items are invalid');\nconst message = 'مرحباً ' + name + '، تم استلام طلبك من متجر بخور الشيخ بنجاح.\\nشكراً لثقتك بنا';\nreturn [{ json: { to: phone, message, orderNumber } }];"
      },
